# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# Ne jamais committer le fichier ".env" reel.

# Base de donnees MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=livraison_ci
DB_USER=root
DB_PASS=

# Application
APP_ENV=production
APP_URL=https://votre-domaine.com
APP_NOM=CityHub 225

# Securite
SESSION_LIFETIME=7200

# Anthropic Claude API (assistant support client)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Notifications Web Push (VAPID)
# Generer avec : php scripts/generate_vapid.php
# Requiert HTTPS en production (le push ne fonctionne pas en http hors localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=storage/vapid_private.pem
VAPID_SUBJECT=mailto:contact@votre-domaine.com

# Devise des paiements (XOF = franc CFA)
DEVISE_PAIEMENT=XOF

# Geocodage d'adresses (Nominatim / OpenStreetMap). Email de contact recommande
# par la politique d'usage de Nominatim (facultatif mais conseille en production).
NOMINATIM_EMAIL=

# Serveur OSRM pour le map-matching des traces (routes calees sur les rues).
# Par defaut le serveur public de demonstration ; pour de la production fiable,
# hebergez votre propre OSRM et indiquez son URL ici.
OSRM_BASE_URL=https://router.project-osrm.org

# Mobile Money - Orange Money (Web Payment API, OAuth2 client_credentials)
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

# Mobile Money - MTN Mobile Money (Collection API)
MTN_MOMO_BASE_URL=https://proxy.momoapi.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=mtnci

# Mobile Money - Moov Money
MOOV_MONEY_BASE_URL=
MOOV_MONEY_CLIENT_ID=
MOOV_MONEY_CLIENT_SECRET=
MOOV_MONEY_MERCHANT_ID=

# Wave (Checkout API)
WAVE_BASE_URL=https://api.wave.com
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# GeniusPay (agregateur Mobile Money Orange/MTN/Wave - PAS Moov, non
# supporte). Doc : http://pay.genius.ci/docs/api
# GENIUSPAY_API_KEY = cle publique (pk_sandbox_... / pk_live_...)
# GENIUSPAY_API_SECRET = cle secrete (sk_sandbox_... / sk_live_...)
# GENIUSPAY_WEBHOOK_SECRET = secret de signature des webhooks (whsec_...)
GENIUSPAY_BASE_URL=http://pay.genius.ci/api/v1/merchant
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
