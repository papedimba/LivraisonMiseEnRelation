# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# Ne jamais committer le fichier ".env" reel.

# Base de donnees MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=livraison_ci
DB_USER=root
DB_PASS=

# Application
APP_ENV=production
APP_URL=https://votre-domaine.com
APP_NOM=LivraisonCI

# Securite
SESSION_LIFETIME=7200

# Anthropic Claude API (assistant support client)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Notifications Web Push (VAPID)
# Generer avec : php scripts/generate_vapid.php
# Requiert HTTPS en production (le push ne fonctionne pas en http hors localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=storage/vapid_private.pem
VAPID_SUBJECT=mailto:contact@votre-domaine.com

# Mobile Money - Orange Money
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_SECRET=

# Mobile Money - MTN Mobile Money
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_USER_ID=

# Mobile Money - Moov Money
MOOV_MONEY_API_KEY=
MOOV_MONEY_MERCHANT_ID=

# Wave
WAVE_API_KEY=
WAVE_SECRET=
